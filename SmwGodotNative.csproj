<Project Sdk="Godot.NET.Sdk/4.6.3">
  <PropertyGroup>
    <TargetFramework Condition="'$(GodotWebDotNetPrototype)' == 'true'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(GodotWebDotNetPrototype)' != 'true'">net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GodotDisabledSourceGenerators>ScriptPathAttribute</GodotDisabledSourceGenerators>
    <DefaultItemExcludes>$(DefaultItemExcludes);.godot/**;.godot_local/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GodotWebDotNetPrototype)' == 'true'">
    <DefineConstants>$(DefineConstants);GODOT_WEB</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove=".godot/**/*.cs" />
    <Compile Remove=".godot_local/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>
</Project>
